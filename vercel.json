{
    "version": 2,
    "builds": [
        {
            "src": "api/**/*.js",
            "use": "@vercel/node"
        },
        {
            "src": "public/",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "public"
            }
        }
    ],
    "installCommand": "npm install && npm install -g hugo-cli && hugo version",
    "buildCommand": "hugo --minify",
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/$1.js"
        }
    ]
}